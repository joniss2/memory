# Ablage ------------------------------------------------------------------
PROVENANCE_DATABASE_URL=postgresql://provenance:provenance@localhost:5432/provenance
PROVENANCE_EMBEDDING_DIM=1024
# Textsuchkonfiguration für den Volltextindex. 'simple' ist sprachneutral und
# passt zu der Rolle, die die Volltextquelle in der Fusion spielt (Eigennamen,
# Zahlen). Nach einer Änderung: `provenance reindex`.
PROVENANCE_FTS_CONFIG=simple

# Modell ------------------------------------------------------------------
# heuristic = deterministischer Ersatz ohne Netz (Vorgabe, siehe README)
# openai    = jede OpenAI-kompatible Schnittstelle, also auch Ollama und vLLM
# naive     = Vergleichsmaßstab für die Eval, kein Betriebsmodus
PROVENANCE_LLM_PROVIDER=heuristic
PROVENANCE_LLM_BASE_URL=http://localhost:11434/v1
PROVENANCE_LLM_API_KEY=
# http:// zu einem entfernten Modell zulassen -- gilt für die Textgenerierung
# und die Einbettungen. Ohne dies wird ein solcher Endpunkt abgelehnt:
# Gesprächsinhalte und API-Schlüssel gingen sonst im Klartext über das Netz.
PROVENANCE_LLM_ALLOW_INSECURE_HTTP=false
PROVENANCE_LLM_MODEL_EXTRACT=qwen2.5:7b-instruct
PROVENANCE_LLM_MODEL_CONSOLIDATE=qwen2.5:7b-instruct

# Einbettungen ------------------------------------------------------------
PROVENANCE_EMBEDDING_PROVIDER=hashing
PROVENANCE_EMBEDDING_BASE_URL=http://localhost:11434/v1
PROVENANCE_EMBEDDING_MODEL=bge-m3

# Stufe 2: Vergessen ist teurer als Erinnern ------------------------------
PROVENANCE_ADD_MIN_CONFIDENCE=0.35
PROVENANCE_UPDATE_MIN_CONFIDENCE=0.55
PROVENANCE_RETRACT_MIN_CONFIDENCE=0.75
PROVENANCE_CONSOLIDATE_SIMILARITY_FLOOR=0.35

# Stufen 3 und 4 ----------------------------------------------------------
PROVENANCE_RETRIEVAL_LIMIT=12
PROVENANCE_RRF_K=60
PROVENANCE_GRAPH_HOPS=2
PROVENANCE_INJECTION_TOKEN_BUDGET=512

# Aufbewahrung und Betrieb -------------------------------------------------
PROVENANCE_TRACE_RETENTION_DAYS=30
# Loopback als Vorgabe. Wer darüber hinaus lauscht, braucht ein Token --
# sonst verweigert der Dienst den Start.
PROVENANCE_HOST=127.0.0.1
PROVENANCE_PORT=8080
PROVENANCE_DASHBOARD_ENABLED=true
# Wenn gesetzt, verlangt die HTTP-API Bearer-Authentisierung.
PROVENANCE_API_TOKEN=
# Start ohne Token auch jenseits von Loopback zulassen. Nur für
# Wegwerf-Umgebungen -- die API bietet Abruf, Auskunft und Löschung an.
PROVENANCE_ALLOW_UNAUTHENTICATED=false
